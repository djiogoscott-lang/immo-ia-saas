# =============================================================================
# Nestenn IA V2 — Template de variables d'environnement
# =============================================================================
# Copier ce fichier en `.env.local` (ignoré par .gitignore) et remplir
# les valeurs réelles depuis vos dashboards respectifs.
# NE JAMAIS commiter `.env.local` ni ses dérivés.
# =============================================================================

# --- LLM (OpenRouter) -------------------------------------------------------
# Récupérer sur https://openrouter.ai > Settings > Keys
OPENROUTER_API_KEY=your_openrouter_key_here

# --- Supabase (Auth + DB + Storage) -----------------------------------------
# Dashboard Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- App URL (utilisée par OpenRouter pour la traçabilité) ------------------
# En dev : http://localhost:3000 ou le port utilisé
# En prod : votre domaine final (Vercel, Lovable, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Embeddings (RAG) -------------------------------------------------------
# Nomic Atlas (modèle "nomic-embed-text-v1.5", 768 dimensions, multilingue).
# Récupérer une clé sur https://atlas.nomic.ai > API keys (free tier généreux).
NOMIC_API_KEY=your_nomic_key_here

# --- API Légifrance (My Juridic Assistant) ----------------------------------
# Récupérer dans la console https://piste.gouv.fr > votre application
PISTE_CLIENT_ID=your_piste_client_id
PISTE_CLIENT_SECRET=your_piste_client_secret
PISTE_TOKEN_URL=https://oauth.piste.gouv.fr/api/oauth/token
PISTE_API_URL=https://api.piste.gouv.fr/dila/legifrance/lf-engine-app

# --- Secrets internes -------------------------------------------------------
# Générer avec : openssl rand -hex 32
CRON_SECRET=your_cron_secret_minimum_32_chars

# --- Feature flags ----------------------------------------------------------
ENABLE_V2_LEGAL_BRIEF=true
ENABLE_DOMAIN_PACKS=true
ENABLE_BAUX_PACK_ACTIVE=true
ENABLE_JURI_FILTER=true

# --- Mode démo --------------------------------------------------------------
# Si true : auth désactivée (toutes les routes accessibles publiquement),
# persistance Supabase bypassée, rate limit par IP au lieu de par user.
# ⚠️ À utiliser UNIQUEMENT pour des démos / tests d'UI sans backend complet.
# Ne JAMAIS activer en production réelle.
DEMO_MODE=false

# --- Limites (optionnel) ----------------------------------------------------
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_SESSION=3
TOKEN_CACHE_DURATION_SECONDS=3600
CONVERSATION_RETENTION_DAYS=30
